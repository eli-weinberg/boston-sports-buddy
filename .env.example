# LLM provider — set the key for whichever provider you configure in settings.yaml
ANTHROPIC_API_KEY=sk-ant-...   # used when scoring.provider: anthropic (default)
OPENAI_API_KEY=sk-...          # used when scoring.provider: openai

# Reddit: no credentials needed — public RSS feeds are used automatically

# Slack (optional — needed for Slack delivery)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email (optional — needed for email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=
EMAIL_TO=you@example.com
